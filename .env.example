# ══════════════════════════════════════════════════════════════════════════════
#  ObliWAN — environment
#  Copy to .env and adjust. install.sh generates the secrets for you.
# ══════════════════════════════════════════════════════════════════════════════

# ── Image version (Docker Hub tag: latest, dev, 1.0.0 …) ──
OBLIWAN_VERSION=latest

# ── Database ──
# Built-in postgres container (docker-compose.yml / .build.yml / .host.yml):
DB_PASSWORD=changeme

# External PostgreSQL (docker-compose.external-db.yml) — set this instead:
# DATABASE_URL=postgres://obliwan:yourpassword@your-db-host:5432/obliwan

# ── Server ──
NODE_ENV=production
SESSION_SECRET=change-this-to-a-random-secret

# ┌──────────────────────────────────────────────────────────────────────────┐
# │  OBLIWAN_ENCRYPTION_KEY — READ THIS.                                     │
# │                                                                          │
# │  This key, and this key alone, encrypts every device credential stored   │
# │  by ObliWAN: RouterOS API logins, SSH keys and passphrases, SNMPv3 USM   │
# │  secrets, SonicOS API accounts, TR-069 Digest passwords — the full       │
# │  administrative access to your customers' WAN fleet.                     │
# │                                                                          │
# │  LOSE IT OR CHANGE IT AND EVERY STORED CREDENTIAL BECOMES PERMANENTLY    │
# │  UNREADABLE. There is no recovery path: the server will start normally,  │
# │  report no error, and simply fail to connect to every single device.     │
# │  The only fix is re-entering every credential by hand.                   │
# │                                                                          │
# │  * It is DELIBERATELY separate from SESSION_SECRET, so that rotating a   │
# │    session secret can never destroy the vault.                           │
# │  * Back it up somewhere other than this host, before the first device    │
# │    is provisioned.                                                       │
# │  * Rotation is supported through the key_version column — use the        │
# │    documented rotation procedure, never a manual edit of this value.     │
# │                                                                          │
# │  Generate with:  openssl rand -hex 32                                    │
# │  No openssl (Windows):                                                   │
# │    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# │                                                                          │
# │  HEXADECIMAL, exactly 64 characters — 0-9 and a-f, nothing else.         │
# │  `openssl rand -base64 32` and password generators produce something     │
# │  that LOOKS like a key and is not hex; the server refuses to start on    │
# │  one, because Buffer.from(key,'hex') would silently truncate it.         │
# └──────────────────────────────────────────────────────────────────────────┘
OBLIWAN_ENCRYPTION_KEY=change-this-to-64-hex-chars

# ── Execution role ──
# all    : single process, does both web and background work (default)
# web    : HTTP/Socket.io only — no pollers, no job runner
# worker : background only — pollers, job queue, drift runs
# Multiple `web` replicas may run side by side; the background duties are held
# by a single leader elected through a PostgreSQL advisory lock.
OBLIWAN_ROLE=all

# ── Client ──
# CLIENT_ORIGIN is used for CORS and for the Obligate SSO redirect. It must be
# the URL users actually type in the browser.
CLIENT_ORIGIN=http://localhost:3004
# true behind a TLS reverse proxy (Secure session cookie)
FORCE_HTTPS=false

# APP_URL — the public address of THIS instance, for links that leave the
# server (today: the password-reset mail). Optional, and normally left unset:
# in the Docker deployment nginx serves the web client and proxies the API, so
# CLIENT_ORIGIN already names the same origin and is used as the fallback.
#
# Set it only when the two genuinely differ — an instance published under a
# different hostname than the one CORS checks.
#
# The value the server uses is APP_URL, else CLIENT_ORIGIN, and NOTHING when
# neither is a public address: a localhost CLIENT_ORIGIN is a development
# value, and a development address in a reset mail is a link to the
# RECIPIENT's own machine. With no public URL the mail is refused rather than
# sent broken — the user's one-shot token is not spent on a dead link.
# Same rule as Obliance's `publicUrlFromEnv()`; keep the suite in step.
# APP_URL=https://obliwan.example.com
# Host port for the nginx client. 3000/3001/3002/3003/3020/3100 are already
# used by the other Obli* products.
LISTEN_PORT=3004

# ── Inbound device listeners (published by the `server` service) ──
# Documented exception to the Obli* topology — see docker-compose.yml.
# TR-069 (CWMP), SNMP trap and syslog listener ports (defaults shown).
# CWMP_PORT=7547
# CWMP_TLS_PORT=7548
# SNMP_TRAP_PORT=162
# SYSLOG_PORT=514
# Syslog lines kept per day, per ROUTER (keyed on the hostname it announces:
# the bridge NATs every router to one source address), and for the whole fleet.
# SYSLOG_DAILY_QUOTA=50000
# SYSLOG_FLEET_DAILY_QUOTA=2000000

# ── App name (prefix in notification messages) ──
APP_NAME=ObliWAN

# ── Default admin (created on first run, local login fallback) ──
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ── Bench tool artefacts (the preparation-workstation installer) ──
# The server IMAGE carries the signed installer: the release script builds
# and signs the bench BEFORE the server image, and server/Dockerfile copies
# it in. A default deployment therefore serves it with nothing to set.
#
# Override, to publish a newer installer without rebuilding the server:
# uncomment the `/bench-override` volume in docker-compose.yml, put the
# SIGNED obliwan-bench.msi and its VERSION file in BENCH_DIR, and set
# BENCH_ARTEFACT_DIR to the mount point. Never mount onto
# /app/server/dist-bench itself: a bind mount hides the image content.
# BENCH_DIR=./bench
# BENCH_ARTEFACT_DIR=/bench-override

# ── Backups — see "PERSISTENT DATA" in the header of docker-compose.yml ──
# Pre-change device backups are written under OBLIWAN_BACKUP_ROOT,
# INSIDE the server container, on the `change_backups` volume. The one value
# feeds both the server's environment and the volume's mount target. Leave it
# unset unless you have a reason; if you set it, give an ABSOLUTE container
# path (Docker refuses a relative mount target when it creates the container).
# OBLIWAN_BACKUP_ROOT=/app/server/data/backups
#
# Nightly database dump + tar.gz of change_backups, OPT-IN: the `db-backup`
# service starts only under the "backup" profile. Compose reads
# COMPOSE_PROFILES from this file. It is ONE comma-separated list for every
# optional service, and profiles add up: with the WireGuard sidecar as well
# (the `wg` profile, see the header of docker-compose.yml) it reads
# COMPOSE_PROFILES=backup,wg. Keep a single COMPOSE_PROFILES line: a second
# one replaces the first instead of adding to it, and the profile it drops is
# no longer created or refreshed on the next `up -d`.
# COMPOSE_PROFILES=backup
#
# Where the dumps and archives land: a named volume (the default) or a host
# path. The default volume sits on the database's own disk, which makes it a
# convenience, not a backup: point it at storage that outlives this host.
# DB_BACKUP_DIR=db_dumps
# DB_BACKUP_DIR=/mnt/backup/obliwan
#
# HH:MM, UTC (the container's clock), once a night.
# DB_BACKUP_TIME=01:30
# Retention, per kind (dump, archive): files older than KEEP_DAYS are pruned,
# the newest KEEP_MIN are always kept, and nothing is pruned after a failure.
# DB_BACKUP_KEEP_DAYS=14
# DB_BACKUP_KEEP_MIN=7
# 1 = also take one at container start (a broken setup shows the day it is
# deployed); 0 = nightly only.
# DB_BACKUP_ON_START=1
# Free space kept on the backup target, in MB, on top of the expected size of
# the next file; a write that would eat into it is SKIPPED and logged.
# DB_BACKUP_MIN_FREE_MB=1024
# postgres image tag used for pg_dump. pg_dump refuses a server of a newer
# major version than its own: keep it at or above the database's major.
# DB_BACKUP_PG_TAG=16-alpine

# ── Custom directory (scripts, SSH keys — persists across updates) ──
# Mounted at /custom inside the server container.
# Default: ./custom (next to your docker-compose.yml)
# Unraid example: CUSTOM_DIR=/mnt/user/appdata/obliwan/custom
# CUSTOM_DIR=./custom
